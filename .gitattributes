# Normalise line endings. The validation script and every manifest are
# consumed by Linux containers and CI runners; CRLF in a .sh file fails with
# "bad interpreter" and CRLF inside YAML values leaks trailing whitespace.
* text=auto eol=lf

*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
